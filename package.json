{
  "name": "cyberfox-quote-builder",
  "version": "1.0.0",
  "private": true,
  "description": "HubSpot deal-record Quote Builder card for CyberFOX (developer projects platform 2026.03).",
  "type": "module",
  "scripts": {
    "sync": "node scripts/sync-shared.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run sync && npm test && npm run typecheck && npm run test:card",
    "setup:properties": "node scripts/create-properties.mjs",
    "setup:tag-products": "node scripts/tag-products.mjs",
    "setup:timus-hubdb": "node scripts/create-timus-hubdb.mjs",
    "upload": "npm run check && hs project upload",
    "dev": "npm run sync && hs project dev",
    "typecheck": "tsc -p tests/card/tsconfig.json",
    "test:card": "esbuild tests/card/render.test.jsx --bundle --platform=node --format=esm --jsx=automatic --outfile=tests/card/.out/render.test.mjs --log-level=warning --external:vitest && node --test tests/card/.out/render.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@hubspot/ui-extensions": "0.17.0",
    "@types/react": "^18.3.0",
    "esbuild": "^0.25.0",
    "react": "18.3.1",
    "typescript": "^5.6.0"
  }
}
